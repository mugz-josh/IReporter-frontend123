{
  "name": "ireporter-backend",
  "version": "1.0.0",
  "description": "Backend for iReporter application",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npx kill-port 3000 2>nul || true && ts-node-dev --respawn --transpile-only server.ts",
    "dev:kill": "npx kill-port 3000 && npm run dev",
    "dev:force": "npx kill-port 3000 2>nul || true && npm run dev",
    "build": "tsc",
    "test": "jest",
    "clean": "npx kill-port 3000 3001 5432 2>nul || true"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.8.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.16.0",
    "kill-port": "^2.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
